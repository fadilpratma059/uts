    @method('PUT')

    <label>Siswa</label>
    <select name="siswa_id" required>
        @foreach($siswa as $item)
            <option value="{{ $item->id }}"
                @selected(old('siswa_id', $biodata->siswa_id) == $item->id)>
                {{ $item->nama_siswa }}
            </option>
        @endforeach
    </select>

    <label>Alamat</label>
    <input type="text" name="alamat"
           value="{{ old('alamat', $biodata->alamat) }}" required>

    <label>No. HP</label>
    <input type="text" name="no_hp"
           value="{{ old('no_hp', $biodata->no_hp) }}" required>

    <button type="submit">Update</button>
</form>

<a href="{{ route('biodata.index') }}">Kembali</a>
@endsection
```

