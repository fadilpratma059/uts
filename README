### I. `biodata/create.blade.php`

```
@extends('layouts.app')

@section('title', 'Tambah Biodata')

@section('content')
<h1>Tambah Biodata</h1>

<form action="{{ route('biodata.store') }}" method="POST">
    @csrf

    <label>Siswa</label>
    <select name="siswa_id" required>
        <option value="">-- Pilih Siswa --</option>
        @foreach($siswa as $item)
            <option value="{{ $item->id }}"
                @selected(old('siswa_id') == $item->id)>
                {{ $item->nama_siswa }}
            </option>
        @endforeach
    </select>

    <label>Alamat</label>
    <input type="text" name="alamat" value="{{ old('alamat') }}" required>

    <label>No. HP</label>
    <input type="text" name="no_hp" value="{{ old('no_hp') }}" required>

    <button type="submit">Simpan</button>
</form>

<a href="{{ route('biodata.index') }}">Kembali</a>
@endsection
```

### J. `biodata/edit.blade.php`

